{
  "manifest_version": 3,
  "name": "Buffaloes Police",
  "version": "1.0",
  "description": "バファローズ警察",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/card.css"
      ]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Buffaloes Police"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles/card.css"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}