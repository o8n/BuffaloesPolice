{
  "manifest_version": 3,
  "name": "Buffaloes Police",
  "version": "1.0",
  "description": "バファローズ警察",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Buffaloes Police"
  }
}
